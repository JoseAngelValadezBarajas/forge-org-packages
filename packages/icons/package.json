{
  "name": "@corefoundry-labs/forge-icons",
  "private": false,
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoseAngelValadezBarajas/forge-org-packages.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck:consumer": "node ../../node_modules/typescript/bin/tsc --project tsconfig.consumer.json",
    "test": "vitest run --config vitest.config.ts && npm run build && npm run typecheck:consumer && node --test scripts/package-exports.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}

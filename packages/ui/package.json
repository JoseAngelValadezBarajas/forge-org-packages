{
  "name": "@corefoundry-labs/forge-ui",
  "description": "Accessible React components with stable V1 APIs, scoped dynamic themes, and independent V2 components.",
  "private": false,
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoseAngelValadezBarajas/forge-org-packages.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/JoseAngelValadezBarajas/forge-org-packages/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/JoseAngelValadezBarajas/forge-org-packages/issues"
  },
  "keywords": ["react", "design-system", "ui", "components", "corefoundry"],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./theme": {
      "types": "./dist/components/layout/ThemeScope/ThemeScope.d.ts",
      "import": "./dist/components/layout/ThemeScope/ThemeScope.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build --workspace=@corefoundry-labs/forge-tokens && vitest run --config vitest.config.ts && npm run build && node scripts/css-distribution.test.mjs && node scripts/component-architecture.test.mjs && node --test scripts/shared-components.browser.test.mjs && node --test scripts/ui-playground.browser.test.mjs"
  },
  "dependencies": {
    "@corefoundry-labs/forge-icons": "1.2.0",
    "@corefoundry-labs/forge-tokens": "1.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}

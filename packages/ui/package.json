{
  "name": "@corefoundry-labs/forge-ui",
  "private": false,
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoseAngelValadezBarajas/forge-org-packages.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run --config vitest.config.ts && npm run build && node scripts/css-distribution.test.mjs && node scripts/component-architecture.test.mjs && node --test scripts/shared-components.browser.test.mjs"
  },
  "dependencies": {
    "@corefoundry-labs/forge-icons": "1.0.1",
    "@corefoundry-labs/forge-tokens": "1.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
